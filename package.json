{
  "name": "bookhub",
  "version": "3.0.0",
  "description": "BookHub: browse the books in a Zotero library with covers, summaries and Turabian citations",
  "main": "main.js",
  "scripts": {
    "start": "vite",
    "build": "vite build --emptyOutDir",
    "lint": "eslint src",
    "format": "prettier --ignore-path ./.gitignore --write \"./**/*.{html,json,js,ts,css}\"",
    "preview": "vite preview"
  },
  "author": "Letlotlo Hlaoli",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "vite": "^5.4.7"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "browserslist": [
    "last 3 and_chr versions",
    "last 3 chrome versions",
    "last 3 opera versions",
    "last 3 ios_saf versions",
    "last 3 safari versions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlaolil/wdd-project2.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/hlaolil/wdd-project2/issues"
  },
  "homepage": "https://github.com/hlaolil/wdd-project2#readme"
}
